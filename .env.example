# Public Vite variables. These values are bundled into the browser; never put secrets here.
VITE_CONTACT_EMAIL=
# Optional override; by default the contact form posts to /api/contact.
# VITE_CONTACT_ENDPOINT=/api/contact
# Optional Google Analytics measurement ID; leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Add the following SERVER-SIDE variables in Vercel Project Settings.
# Do not put these in VITE_* variables or commit real values to Git.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender address/domain verified with Resend.
CONTACT_FROM_EMAIL=
